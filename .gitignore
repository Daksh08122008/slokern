# ============================================================
# SLOKern — .gitignore
# ============================================================

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
.nenv

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Python environments and package managers ---
.venv/
venv/
env/
ENV/
.python-version.local
__pypackages__/

# --- Python tooling and test caches ---
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
.pyre/
.dmypy.json
dmypy.json

# --- Jupyter notebooks ---
.ipynb_checkpoints/

# --- Frontend / Node.js ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
*.tsbuildinfo

# Keep package-manager lockfiles tracked:
# uv.lock, package-lock.json, pnpm-lock.yaml, yarn.lock

# --- Build and generated temporary files ---
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
.tmp/
temp/

# --- Logs and runtime output ---
*.log
logs/
*.pid
*.seed
*.pid.lock
*.out

# --- SLOKern local state ---
.slokern/
.slokern-local/
.local/
instance/
*.sqlite
*.sqlite3
*.db

# --- Experiment outputs: raw artifacts stay local ---
artifacts/*
!artifacts/.gitkeep

# Ignore local results but preserve curated judge evidence.
results/*
!results/final/
!results/final/**
!results/.gitkeep

# --- Model weights and downloaded datasets ---
models/
model_cache/
model-cache/
checkpoints/
weights/
datasets/
downloads/
*.safetensors
*.gguf
*.ggml
*.pt
*.pth
*.onnx
*.engine
*.bin

# --- GPU / profiler output ---
*.nsys-rep
*.qdrep
*.qdstrm
*.ncu-rep
*.prof
profiler-results/

# --- OS-generated files ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors and IDEs ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.sublime-workspace
*.code-workspace

# --- Local containers and deployment overrides ---
docker-compose.override.yml
compose.override.yaml
