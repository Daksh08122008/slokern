{
  "additionalProperties": false,
  "description": "Granular, unaggregated event capture for every request. Must be preserved for reproducibility.",
  "properties": {
    "request_id": {
      "description": "Unique request identifier",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "description": "Associated run identifier",
      "title": "Run Id",
      "type": "string"
    },
    "scheduled_at": {
      "description": "Intended dispatch timestamp (epoch seconds / ISO)",
      "title": "Scheduled At",
      "type": "number"
    },
    "sent_at": {
      "description": "Socket write start timestamp",
      "title": "Sent At",
      "type": "number"
    },
    "first_token_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "First token receipt timestamp (nullable for non-streaming or failed requests)",
      "title": "First Token At"
    },
    "completed_at": {
      "description": "Response completion or abort timestamp",
      "title": "Completed At",
      "type": "number"
    },
    "http_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Response code",
      "title": "Http Status"
    },
    "input_tokens": {
      "description": "Measured prompt token count",
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "description": "Measured generated token count",
      "title": "Output Tokens",
      "type": "integer"
    },
    "itl_observations_ms": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional list of inter-token intervals in milliseconds",
      "title": "Itl Observations Ms"
    },
    "error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error classification if failed",
      "title": "Error Type"
    },
    "is_warmup": {
      "description": "Boolean indicating if sample occurred during warm-up (excluded from metrics)",
      "title": "Is Warmup",
      "type": "boolean"
    },
    "is_valid": {
      "description": "Boolean indicating whether sample is free of client-side measurement anomalies",
      "title": "Is Valid",
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "scheduled_at",
    "sent_at",
    "completed_at",
    "input_tokens",
    "output_tokens",
    "is_warmup",
    "is_valid"
  ],
  "title": "RawRequestMeasurement",
  "type": "object"
}
