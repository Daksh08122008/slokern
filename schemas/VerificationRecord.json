{
  "$defs": {
    "ConstraintEvaluation": {
      "additionalProperties": false,
      "properties": {
        "metric_name": {
          "description": "Target metric",
          "title": "Metric Name",
          "type": "string"
        },
        "statistic": {
          "description": "Evaluated statistic",
          "title": "Statistic",
          "type": "string"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Derived metric value (null if metric missing or sample insufficient)",
          "title": "Observed Value"
        },
        "required_threshold": {
          "description": "Threshold from SLOSpec",
          "title": "Required Threshold",
          "type": "number"
        },
        "operator": {
          "description": "Comparison operator",
          "title": "Operator",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boolean or null",
          "title": "Passed"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode",
          "description": "Machine-readable reason code"
        }
      },
      "required": [
        "metric_name",
        "statistic",
        "required_threshold",
        "operator",
        "reason_code"
      ],
      "title": "ConstraintEvaluation",
      "type": "object"
    },
    "DriftAnalysis": {
      "additionalProperties": false,
      "properties": {
        "metric_deltas": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Percent difference between search run and verification run metrics",
          "title": "Metric Deltas",
          "type": "object"
        },
        "slo_drift_detected": {
          "description": "Boolean indicating whether verification drifted across a threshold",
          "title": "Slo Drift Detected",
          "type": "boolean"
        },
        "metric_comparisons": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/MetricDriftComparison"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detailed per-metric drift evaluations",
          "title": "Metric Comparisons"
        },
        "drift_exceeded": {
          "default": false,
          "description": "True if any required metric exceeded its declared drift tolerance",
          "title": "Drift Exceeded",
          "type": "boolean"
        }
      },
      "required": [
        "metric_deltas",
        "slo_drift_detected"
      ],
      "title": "DriftAnalysis",
      "type": "object"
    },
    "EvidenceValidity": {
      "description": "Integrity of the measurement evidence collected during a run.",
      "enum": [
        "VALID",
        "INVALID",
        "CONTAMINATED"
      ],
      "title": "EvidenceValidity",
      "type": "string"
    },
    "FeasibilityResult": {
      "additionalProperties": false,
      "description": "Deterministic constraint audit result.",
      "properties": {
        "policy_version": {
          "description": "Version of feasibility evaluation rules",
          "title": "Policy Version",
          "type": "string"
        },
        "run_id": {
          "description": "Associated run identifier",
          "title": "Run Id",
          "type": "string"
        },
        "overall_verdict": {
          "$ref": "#/$defs/FeasibilityVerdict",
          "description": "Enum: FEASIBLE, INFEASIBLE, INCONCLUSIVE"
        },
        "constraint_evaluations": {
          "description": "List of per-constraint evaluation records",
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          },
          "title": "Constraint Evaluations",
          "type": "array"
        },
        "validity_status": {
          "$ref": "#/$defs/EvidenceValidity",
          "description": "Enum: VALID, INVALID, CONTAMINATED"
        },
        "audit_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured text explaining edge cases or exclusions",
          "title": "Audit Notes"
        }
      },
      "required": [
        "policy_version",
        "run_id",
        "overall_verdict",
        "constraint_evaluations",
        "validity_status"
      ],
      "title": "FeasibilityResult",
      "type": "object"
    },
    "FeasibilityVerdict": {
      "description": "Deterministic assessment of a MetricSet against hard SLO constraints.",
      "enum": [
        "FEASIBLE",
        "INFEASIBLE",
        "INCONCLUSIVE"
      ],
      "title": "FeasibilityVerdict",
      "type": "string"
    },
    "MetricDriftComparison": {
      "additionalProperties": false,
      "description": "Detailed drift evaluation for an individual metric.",
      "properties": {
        "metric_name": {
          "description": "Canonical metric identifier",
          "title": "Metric Name",
          "type": "string"
        },
        "reference_value": {
          "description": "Reference measurement from winning search run",
          "title": "Reference Value",
          "type": "number"
        },
        "verification_value": {
          "description": "Fresh measurement from independent verification run",
          "title": "Verification Value",
          "type": "number"
        },
        "absolute_drift": {
          "description": "Absolute difference between verification and reference",
          "title": "Absolute Drift",
          "type": "number"
        },
        "relative_drift": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Percentage drift relative to reference when defined",
          "title": "Relative Drift"
        },
        "tolerance": {
          "description": "Declared drift tolerance threshold",
          "title": "Tolerance",
          "type": "number"
        },
        "comparison_method": {
          "description": "Mathematical comparison formula applied",
          "enum": [
            "relative_percentage",
            "absolute_difference"
          ],
          "title": "Comparison Method",
          "type": "string"
        },
        "unit": {
          "description": "Explicit metric unit",
          "title": "Unit",
          "type": "string"
        },
        "passed": {
          "description": "True if drift is within accepted tolerance",
          "title": "Passed",
          "type": "boolean"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Diagnostic reason if drift failed or could not be evaluated",
          "title": "Failure Reason"
        }
      },
      "required": [
        "metric_name",
        "reference_value",
        "verification_value",
        "absolute_drift",
        "tolerance",
        "comparison_method",
        "unit",
        "passed"
      ],
      "title": "MetricDriftComparison",
      "type": "object"
    },
    "MetricSet": {
      "additionalProperties": false,
      "description": "Derived performance indicators calculated deterministically from valid measurement windows.\nTraceable to raw request records (RawRequestMeasurement).",
      "properties": {
        "metric_version": {
          "description": "Version of metric calculation policy",
          "title": "Metric Version",
          "type": "string"
        },
        "run_id": {
          "description": "Associated run identifier",
          "title": "Run Id",
          "type": "string"
        },
        "sample_count": {
          "description": "Count of completed valid requests analyzed",
          "title": "Sample Count",
          "type": "integer"
        },
        "failed_request_count": {
          "description": "Count of failed or aborted requests",
          "title": "Failed Request Count",
          "type": "integer"
        },
        "offered_load_rps": {
          "description": "Actual rate at which client scheduled requests",
          "title": "Offered Load Rps",
          "type": "number"
        },
        "achieved_load_rps": {
          "description": "Actual completed request throughput over the measurement window",
          "title": "Achieved Load Rps",
          "type": "number"
        },
        "generator_saturated": {
          "description": "Boolean flag indicating whether client load generator saturated",
          "title": "Generator Saturated",
          "type": "boolean"
        },
        "ttft_ms": {
          "$ref": "#/$defs/PercentileDistribution",
          "description": "Object containing p50, p90, p95, p99, mean, min, max"
        },
        "itl_ms": {
          "$ref": "#/$defs/PercentileDistribution",
          "description": "Object containing p50, p90, p95, p99, mean (with documented aggregation)"
        },
        "e2e_latency_ms": {
          "$ref": "#/$defs/PercentileDistribution",
          "description": "Percentiles and summary of total request durations"
        },
        "request_throughput_rps": {
          "description": "Achieved completed requests per second",
          "title": "Request Throughput Rps",
          "type": "number"
        },
        "token_throughput_tps": {
          "description": "Total output tokens generated per second",
          "title": "Token Throughput Tps",
          "type": "number"
        },
        "error_rate": {
          "description": "Ratio of failed requests to total offered requests",
          "title": "Error Rate",
          "type": "number"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Optional metadata",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "metric_version",
        "run_id",
        "sample_count",
        "failed_request_count",
        "offered_load_rps",
        "achieved_load_rps",
        "generator_saturated",
        "ttft_ms",
        "itl_ms",
        "e2e_latency_ms",
        "request_throughput_rps",
        "token_throughput_tps",
        "error_rate"
      ],
      "title": "MetricSet",
      "type": "object"
    },
    "PercentileDistribution": {
      "additionalProperties": false,
      "description": "Summary statistics for latency observations in milliseconds.",
      "properties": {
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90"
        },
        "p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95"
        },
        "p99": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P99"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        }
      },
      "title": "PercentileDistribution",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Machine-readable reason codes for feasibility and verification decisions.",
      "enum": [
        "HARD_CONSTRAINTS_PASSED",
        "TTFT_P95_EXCEEDED",
        "TTFT_P50_EXCEEDED",
        "ITL_P95_EXCEEDED",
        "E2E_LATENCY_EXCEEDED",
        "ERROR_RATE_EXCEEDED",
        "THROUGHPUT_DEFICIT",
        "INSUFFICIENT_SAMPLES",
        "GENERATOR_SATURATED",
        "CONTAMINATED_LOAD",
        "MISSING_REQUIRED_METRIC",
        "UNSUPPORTED_OPERATOR",
        "EXECUTION_CRASHED",
        "VERIFICATION_DRIFT_EXCEEDED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "VerificationState": {
      "description": "Independent verification status of the selected winning candidate.",
      "enum": [
        "NOT_RUN",
        "VERIFYING",
        "VERIFIED",
        "VERIFICATION_FAILED",
        "VERIFICATION_INCONCLUSIVE"
      ],
      "title": "VerificationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Independent verification audit record for the winning candidate.",
  "properties": {
    "verification_id": {
      "description": "Unique identifier for the verification session",
      "title": "Verification Id",
      "type": "string"
    },
    "experiment_id": {
      "description": "Associated experiment identifier",
      "title": "Experiment Id",
      "type": "string"
    },
    "candidate_id": {
      "description": "Frozen candidate configuration tested",
      "title": "Candidate Id",
      "type": "string"
    },
    "original_run_id": {
      "description": "Search run ID where candidate was selected",
      "title": "Original Run Id",
      "type": "string"
    },
    "verification_run_id": {
      "description": "Fresh run ID under which rerun was conducted",
      "title": "Verification Run Id",
      "type": "string"
    },
    "verification_verdict": {
      "$ref": "#/$defs/VerificationState",
      "description": "Enum: VERIFIED, VERIFICATION_FAILED, VERIFICATION_INCONCLUSIVE"
    },
    "drift_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/DriftAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Drift analysis"
    },
    "metric_set": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Derived metrics from the verification run"
    },
    "feasibility_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeasibilityResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deterministic feasibility verdict from the verification run"
    },
    "reason_codes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Machine-readable decision reason codes",
      "title": "Reason Codes"
    },
    "final_decision_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Explanation of confirmation or failure",
      "title": "Final Decision Notes"
    }
  },
  "required": [
    "verification_id",
    "experiment_id",
    "candidate_id",
    "original_run_id",
    "verification_run_id",
    "verification_verdict"
  ],
  "title": "VerificationRecord",
  "type": "object"
}
