{
  "$defs": {
    "SLOConstraint": {
      "additionalProperties": false,
      "properties": {
        "metric_name": {
          "description": "Target metric",
          "title": "Metric Name",
          "type": "string"
        },
        "statistic": {
          "description": "Declared statistic",
          "enum": [
            "p50",
            "p90",
            "p95",
            "p99",
            "mean",
            "max"
          ],
          "title": "Statistic",
          "type": "string"
        },
        "threshold": {
          "description": "Numeric threshold value",
          "title": "Threshold",
          "type": "number"
        },
        "unit": {
          "description": "Explicit unit",
          "enum": [
            "ms",
            "s",
            "requests/s",
            "fraction"
          ],
          "title": "Unit",
          "type": "string"
        },
        "operator": {
          "description": "Comparison operator",
          "enum": [
            "<=",
            "<",
            ">=",
            ">"
          ],
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "metric_name",
        "statistic",
        "threshold",
        "unit",
        "operator"
      ],
      "title": "SLOConstraint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Specifies the non-negotiable service-level objectives against which candidates are evaluated.",
  "properties": {
    "slo_id": {
      "description": "Unique identifier for the SLO declaration",
      "title": "Slo Id",
      "type": "string"
    },
    "constraints": {
      "description": "List of hard constraint rules",
      "items": {
        "$ref": "#/$defs/SLOConstraint"
      },
      "title": "Constraints",
      "type": "array"
    },
    "min_sample_count": {
      "description": "Minimum required valid requests to allow an authoritative verdict",
      "title": "Min Sample Count",
      "type": "integer"
    }
  },
  "required": [
    "slo_id",
    "constraints",
    "min_sample_count"
  ],
  "title": "SLOSpec",
  "type": "object"
}
