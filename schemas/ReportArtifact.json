{
  "$defs": {
    "ArrivalMode": {
      "description": "Workload arrival scheduling distribution.",
      "enum": [
        "poisson",
        "constant",
        "closed"
      ],
      "title": "ArrivalMode",
      "type": "string"
    },
    "BaselineSummary": {
      "properties": {
        "baseline_candidate_id": {
          "title": "Baseline Candidate Id",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/FeasibilityVerdict"
        }
      },
      "required": [
        "baseline_candidate_id",
        "verdict",
        "metrics"
      ],
      "title": "BaselineSummary",
      "type": "object"
    },
    "CandidateConfig": {
      "description": "Represents a concrete serving configuration. Distinguishes intent from verified runtime reality.",
      "properties": {
        "candidate_id": {
          "description": "Stable deterministic hash of canonical parameter values",
          "title": "Candidate Id",
          "type": "string"
        },
        "effective_settings": {
          "additionalProperties": true,
          "description": "Key-value pairs confirmed by the adapter via runtime read-back",
          "title": "Effective Settings",
          "type": "object"
        },
        "environment_fingerprint": {
          "additionalProperties": true,
          "description": "Hash/dictionary of GPU hardware, driver, CUDA version, and runtime software commit",
          "title": "Environment Fingerprint",
          "type": "object"
        },
        "model_name": {
          "description": "Formal model identifier",
          "title": "Model Name",
          "type": "string"
        },
        "parameter_status": {
          "additionalProperties": {
            "$ref": "#/$defs/ParameterStatus"
          },
          "description": "Map of parameters to status",
          "title": "Parameter Status",
          "type": "object"
        },
        "requested_settings": {
          "additionalProperties": true,
          "description": "Key-value pairs requested by the search controller",
          "title": "Requested Settings",
          "type": "object"
        },
        "runtime_name": {
          "description": "Serving engine",
          "title": "Runtime Name",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "model_name",
        "runtime_name",
        "requested_settings",
        "effective_settings",
        "parameter_status",
        "environment_fingerprint"
      ],
      "title": "CandidateConfig",
      "type": "object"
    },
    "DriftAnalysis": {
      "properties": {
        "metric_deltas": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Percent difference between search run and verification run metrics",
          "title": "Metric Deltas",
          "type": "object"
        },
        "slo_drift_detected": {
          "description": "Boolean indicating whether verification drifted across a threshold",
          "title": "Slo Drift Detected",
          "type": "boolean"
        }
      },
      "required": [
        "metric_deltas",
        "slo_drift_detected"
      ],
      "title": "DriftAnalysis",
      "type": "object"
    },
    "ExperimentBudget": {
      "properties": {
        "max_candidates": {
          "description": "Hard upper limit on candidate configurations tested",
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_cost_limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional expenditure ceiling",
          "title": "Max Cost Limit"
        },
        "max_wallclock_seconds": {
          "description": "Maximum total experiment duration",
          "title": "Max Wallclock Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_candidates",
        "max_wallclock_seconds"
      ],
      "title": "ExperimentBudget",
      "type": "object"
    },
    "ExperimentSpec": {
      "description": "The root document defining an entire optimization experiment.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/ExperimentBudget",
          "description": "Experiment budget"
        },
        "experiment_id": {
          "description": "Unique identifier for the experiment session",
          "title": "Experiment Id",
          "type": "string"
        },
        "search_space": {
          "additionalProperties": true,
          "description": "Declared legal parameter ranges and candidate generation rules",
          "title": "Search Space",
          "type": "object"
        },
        "slo": {
          "$ref": "#/$defs/SLOSpec",
          "description": "Embedded SLOSpec"
        },
        "verification_policy": {
          "$ref": "#/$defs/ExperimentVerificationPolicy",
          "description": "Rules governing the independent verification rerun"
        },
        "workload": {
          "$ref": "#/$defs/WorkloadSpec",
          "description": "Embedded WorkloadSpec"
        }
      },
      "required": [
        "experiment_id",
        "workload",
        "slo",
        "search_space",
        "budget"
      ],
      "title": "ExperimentSpec",
      "type": "object"
    },
    "ExperimentVerificationPolicy": {
      "properties": {
        "duration_multiplier": {
          "default": 1.0,
          "description": "Multiplier for measurement duration during verification",
          "title": "Duration Multiplier",
          "type": "number"
        },
        "repetitions": {
          "default": 1,
          "description": "Number of verification repetitions",
          "title": "Repetitions",
          "type": "integer"
        }
      },
      "title": "ExperimentVerificationPolicy",
      "type": "object"
    },
    "FeasibilityVerdict": {
      "description": "Deterministic assessment of a MetricSet against hard SLO constraints.",
      "enum": [
        "FEASIBLE",
        "INFEASIBLE",
        "INCONCLUSIVE"
      ],
      "title": "FeasibilityVerdict",
      "type": "string"
    },
    "ParameterStatus": {
      "description": "Status of requested serving configuration parameters after runtime read-back.",
      "enum": [
        "applied",
        "unsupported",
        "rejected",
        "default_fallback"
      ],
      "title": "ParameterStatus",
      "type": "string"
    },
    "SLOConstraint": {
      "properties": {
        "metric_name": {
          "description": "Target metric",
          "title": "Metric Name",
          "type": "string"
        },
        "operator": {
          "description": "Comparison operator",
          "enum": [
            "<=",
            "<",
            ">=",
            ">"
          ],
          "title": "Operator",
          "type": "string"
        },
        "statistic": {
          "description": "Declared statistic",
          "enum": [
            "p50",
            "p90",
            "p95",
            "p99",
            "mean",
            "max"
          ],
          "title": "Statistic",
          "type": "string"
        },
        "threshold": {
          "description": "Numeric threshold value",
          "title": "Threshold",
          "type": "number"
        },
        "unit": {
          "description": "Explicit unit",
          "enum": [
            "ms",
            "s",
            "requests/s",
            "fraction"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric_name",
        "statistic",
        "threshold",
        "unit",
        "operator"
      ],
      "title": "SLOConstraint",
      "type": "object"
    },
    "SLOSpec": {
      "description": "Specifies the non-negotiable service-level objectives against which candidates are evaluated.",
      "properties": {
        "constraints": {
          "description": "List of hard constraint rules",
          "items": {
            "$ref": "#/$defs/SLOConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "min_sample_count": {
          "description": "Minimum required valid requests to allow an authoritative verdict",
          "title": "Min Sample Count",
          "type": "integer"
        },
        "slo_id": {
          "description": "Unique identifier for the SLO declaration",
          "title": "Slo Id",
          "type": "string"
        }
      },
      "required": [
        "slo_id",
        "constraints",
        "min_sample_count"
      ],
      "title": "SLOSpec",
      "type": "object"
    },
    "SearchSummary": {
      "properties": {
        "rankings": {
          "items": {
            "type": "string"
          },
          "title": "Rankings",
          "type": "array"
        },
        "rejected_options": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Options",
          "type": "array"
        },
        "tested_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Tested Candidates",
          "type": "array"
        }
      },
      "required": [
        "tested_candidates",
        "rejected_options",
        "rankings"
      ],
      "title": "SearchSummary",
      "type": "object"
    },
    "VerificationRecord": {
      "description": "Independent verification audit record for the winning candidate.",
      "properties": {
        "candidate_id": {
          "description": "Frozen candidate configuration tested",
          "title": "Candidate Id",
          "type": "string"
        },
        "drift_analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriftAnalysis"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Drift analysis"
        },
        "experiment_id": {
          "description": "Associated experiment identifier",
          "title": "Experiment Id",
          "type": "string"
        },
        "final_decision_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explanation of confirmation or failure",
          "title": "Final Decision Notes"
        },
        "original_run_id": {
          "description": "Search run ID where candidate was selected",
          "title": "Original Run Id",
          "type": "string"
        },
        "verification_id": {
          "description": "Unique identifier for the verification session",
          "title": "Verification Id",
          "type": "string"
        },
        "verification_run_id": {
          "description": "Fresh run ID under which rerun was conducted",
          "title": "Verification Run Id",
          "type": "string"
        },
        "verification_verdict": {
          "$ref": "#/$defs/VerificationState",
          "description": "Enum: VERIFIED, VERIFICATION_FAILED, VERIFICATION_INCONCLUSIVE"
        }
      },
      "required": [
        "verification_id",
        "experiment_id",
        "candidate_id",
        "original_run_id",
        "verification_run_id",
        "verification_verdict"
      ],
      "title": "VerificationRecord",
      "type": "object"
    },
    "VerificationState": {
      "description": "Independent verification status of the selected winning candidate.",
      "enum": [
        "NOT_RUN",
        "VERIFYING",
        "VERIFIED",
        "VERIFICATION_FAILED",
        "VERIFICATION_INCONCLUSIVE"
      ],
      "title": "VerificationState",
      "type": "string"
    },
    "WorkloadSpec": {
      "description": "Defines the offered traffic profile to ensure benchmark repeatability.",
      "properties": {
        "arrival_mode": {
          "$ref": "#/$defs/ArrivalMode",
          "description": "Arrival process"
        },
        "concurrency_limit": {
          "description": "Maximum concurrent requests in flight",
          "title": "Concurrency Limit",
          "type": "integer"
        },
        "fixture_id": {
          "description": "Hash or path of the versioned prompt dataset",
          "title": "Fixture Id",
          "type": "string"
        },
        "max_input_tokens": {
          "description": "Upper bound on input prompt length",
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "description": "Maximum generated token limit",
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "measurement_duration_s": {
          "description": "Active measurement window in seconds",
          "title": "Measurement Duration S",
          "type": "integer"
        },
        "schema_version": {
          "description": "String version identifier (e.g., '1.0.0')",
          "title": "Schema Version",
          "type": "string"
        },
        "target_offered_rate": {
          "description": "Intended requests per second (float, requests/s)",
          "title": "Target Offered Rate",
          "type": "number"
        },
        "warmup_duration_s": {
          "description": "Warm-up window duration in seconds",
          "title": "Warmup Duration S",
          "type": "integer"
        },
        "workload_name": {
          "description": "Identifier for the workload profile",
          "title": "Workload Name",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workload_name",
        "fixture_id",
        "arrival_mode",
        "target_offered_rate",
        "concurrency_limit",
        "warmup_duration_s",
        "measurement_duration_s",
        "max_input_tokens",
        "max_output_tokens"
      ],
      "title": "WorkloadSpec",
      "type": "object"
    }
  },
  "description": "Self-contained, inspectable artifact published for users and hackathon judges.",
  "properties": {
    "artifact_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "References to raw measurement files and logs",
      "title": "Artifact Paths",
      "type": "object"
    },
    "baseline_summary": {
      "$ref": "#/$defs/BaselineSummary",
      "description": "Baseline metrics and verdict"
    },
    "cost_accounting_basis": {
      "description": "Explicit source of pricing data or declaration of unavailable",
      "title": "Cost Accounting Basis",
      "type": "string"
    },
    "created_at": {
      "description": "UTC ISO timestamp",
      "title": "Created At",
      "type": "string"
    },
    "environment_fingerprint": {
      "additionalProperties": true,
      "description": "Full hardware/runtime environment documentation",
      "title": "Environment Fingerprint",
      "type": "object"
    },
    "experiment_spec": {
      "$ref": "#/$defs/ExperimentSpec",
      "description": "Complete immutable specification"
    },
    "limitations_disclosed": {
      "additionalProperties": true,
      "description": "Tested search space bounds and known environment constraints",
      "title": "Limitations Disclosed",
      "type": "object"
    },
    "report_id": {
      "description": "Unique report identifier",
      "title": "Report Id",
      "type": "string"
    },
    "search_summary": {
      "$ref": "#/$defs/SearchSummary",
      "description": "Candidate table, rankings, and rejected options"
    },
    "selected_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Detailed configuration of the winning candidate"
    },
    "verification_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Complete verification audit"
    }
  },
  "required": [
    "report_id",
    "created_at",
    "experiment_spec",
    "environment_fingerprint",
    "baseline_summary",
    "search_summary",
    "limitations_disclosed",
    "cost_accounting_basis",
    "artifact_paths"
  ],
  "title": "ReportArtifact",
  "type": "object"
}
